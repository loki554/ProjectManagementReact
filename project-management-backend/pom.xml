<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.pmtracker</groupId>
	<artifactId>project-management-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- Профиль для локального запуска (spring-boot:run). В application.properties его
		     больше нет и быть не должно: тот файл едет в jar, и зашитый в нём профиль стал бы
		     профилем прода тоже. Здесь это безопасно: pom в jar не попадает, а goal spring-boot:run
		     нужен только для разработки. Переопределяется как обычно: -Dspring-boot.run.profiles=... -->
		<spring-boot.run.profiles>dev</spring-boot.run.profiles>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<!-- bucket4j: token bucket для rate limiting auth-эндпоинтов (см. ratelimit/).
		     Артефакт _jdk17 — это основная линейка библиотеки начиная с 8.x
		     (сборка под Java 17+), core-модуль работает in-memory, без зависимостей;
		     при переходе на несколько инстансов рядом добавляется bucket4j_jdk17-redis. -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>8.14.0</version>
		</dependency>
		<!-- Apache Tika: определение реального типа файла по magic bytes (см. 1.12 IMPROVEMENTS.md).
		     Только tika-core — детекторы по сигнатурам и tika-mimetypes.xml лежат в нём, парсеры
		     (tika-parsers-*, десятки мегабайт транзитивных зависимостей) нам не нужны: содержимое
		     файлов мы не разбираем, только опознаём контейнер. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>3.2.3</version>
		</dependency>
		<!-- ImageIO-плагин с ридером WEBP: стандартный JDK его не умеет, а перекодирование
		     аватарок (1.12) должно работать для всех форматов, которые мы принимаем. -->
		<dependency>
			<groupId>com.twelvemonkeys.imageio</groupId>
			<artifactId>imageio-webp</artifactId>
			<version>3.12.0</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.6</version>
		</dependency>
		<!-- Caffeine: кэш проверки членства в проекте (3.10 IMPROVEMENTS.md). Голая
		     библиотека, без spring-boot-starter-cache: @Cacheable удобен, пока не нужен
		     контроль момента инвалидации, а здесь он нужен — сбрасывать запись надо строго
		     после коммита, иначе параллельное чтение успеет вернуть в кэш старую роль
		     (см. ProjectMembershipCache). Версия задана явно: Boot 4 Caffeine не менеджит. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
			<version>3.2.0</version>
		</dependency>
		<!-- AWS SDK v2, только модуль S3: объектное хранилище как альтернатива локальному
		     диску (3.7 IMPROVEMENTS.md). Берётся не starter от AWS, а голый клиент — Spring
		     Cloud AWS тянет за собой автоконфигурацию половины сервисов AWS ради одного
		     PutObject, а весь наш контракт с хранилищем — четыре метода FileStorageService.
		     Версия задана явно: spring-boot-dependencies AWS SDK не управляет. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.30.0</version>
			<exclusions>
				<!-- Apache HTTP-клиент AWS SDK подтягивает commons-logging, который
				     конфликтует с jcl-over-slf4j из Boot ("multiple bindings"). Синхронному
				     клиенту достаточно UrlConnectionHttpClient, но по умолчанию SDK берёт
				     apache-client — поэтому он остаётся, а лишний логгер исключён. -->
				<exclusion>
					<groupId>commons-logging</groupId>
					<artifactId>commons-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers: интеграционные тесты идут в настоящую Postgres той же версии, что
		     и dev/прод (postgres:16), а не в H2. Разница не косметическая: схемой владеет
		     Flyway, миграции написаны под Postgres (gen_random_uuid, TIMESTAMPTZ, partial
		     indexes), и на H2 их пришлось бы либо переписывать, либо подменять ddl-auto —
		     то есть тестировать не ту схему, которая поедет в прод. Заодно каждый прогон
		     тестов прогоняет миграции с нуля, так что это ещё и тест самих миграций.
		     Версии приходят из testcontainers-bom, который импортирует spring-boot-dependencies. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- MinIO в контейнере: S3-реализация хранилища проверяется против настоящего
		     S3-совместимого сервера, а не против мока SDK. Мок доказал бы только то, что
		     позвали putObject, тогда как всё интересное здесь — в том, как ключи, presigned
		     ссылки и постраничный листинг ведут себя на живом сервере. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-minio</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- GreenMail: SMTP-сервер в процессе теста. Именно сервер, а не мок MailService:
		     письмо со ссылкой подтверждения — часть контракта регистрации, и проверять
		     хочется то, что реально ушло в SMTP (адрес, тема, работающая ссылка с токеном),
		     а не то, что позвали метод. MailHog из docker-compose для этого не годится:
		     он общий на всю машину, письма в нём копятся между прогонами, и тест начинает
		     зависеть от того, чистил ли кто-то ящик руками.
		     junit:junit исключён: GreenMail тащит JUnit 4 в compile-scope ради пары
		     хелперов, а в проекте JUnit 5 — две версии на classpath только путают. -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<version>2.1.13</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>junit</groupId>
					<artifactId>junit</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- .env лежит в корне монорепо (рядом с docker-compose.yml), на уровень выше
			     этого модуля. Пробовали spring-dotenv (EnvironmentPostProcessor), но под
			     Spring Boot 4 он молча не срабатывает (в логах нет ни следа его активности) —
			     похоже, библиотека ещё не адаптирована под новый механизм бутстрапа.
			     Вместо магии на уровне Spring читаем .env как обычный Maven properties-файл
			     (формат KEY=value у него и так properties-совместимый) до сборки и прокидываем
			     значение в JVM как system property — это не зависит от версии Spring Boot вообще.

			     ВАЖНО: goal spring-boot:run форкает свой собственный изолированный lifecycle,
			     и properties, установленные этим плагином в фазе initialize, в форкнутый
			     контекст не попадают (${DB_PASSWORD} останется неразвёрнутым текстом, Spring
			     упадёт с "Circular placeholder reference"). Поэтому фазу initialize нужно
			     запускать явно в той же команде:

			         ./mvnw initialize spring-boot:run

			     а не просто "./mvnw spring-boot:run". -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.2.1</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>${project.basedir}/../.env</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<jvmArguments>-DDB_PASSWORD=${DB_PASSWORD}</jvmArguments>
				</configuration>
			</plugin>
			<!-- JaCoCo: порог покрытия сервисного слоя (см. 2.7 IMPROVEMENTS.md). Смысл не в
			     цифре как таковой, а в храповике: тесты 2.1-2.6 подняли сервисы до ~85% по
			     строкам, и порог не даёт этому тихо съехать вниз, когда в сервис доедет новая
			     ветка без теста. Проверяются именно сервисы (**/*Service.class), а не весь
			     модуль: сущности, DTO и контроллеры — это геттеры и делегирование, их процент
			     говорит о размере кодовой базы, а не о её проверенности, и разбавил бы
			     единственное число, на которое стоит смотреть.

			     Версия зафиксирована: родительский POM Spring Boot 4 JaCoCo не менеджит, и без
			     <version> Maven берёт последнюю из central — сборка перестаёт быть
			     воспроизводимой (а заодно молча ломается в offline-режиме).

			     Порог висит на verify, а не на test: ./mvnw test остаётся быстрым и без агента
			     в argLine, а ворота стоят там, где их проходит CI (./mvnw verify). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<id>check-service-coverage</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<!-- includes здесь фильтрует не правило, а сами анализируемые классы:
							     BUNDLE-правило ниже считает по ним и только по ним. -->
							<includes>
								<include>**/*Service.class</include>
							</includes>
							<rules>
								<!-- Суммарно по сервисам. На момент установки: 85.3% строк,
								     62.9% ветвей — пороги ниже фактических значений с запасом,
								     чтобы падение означало "покрытие ухудшилось", а не
								     "кто-то добавил метод и не дотянул полпроцента".
								     Ветви отдельной строкой: без них можно поднять процент
								     строк, ни разу не зайдя ни в один if. -->
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.55</minimum>
										</limit>
									</limits>
								</rule>
								<!-- Пол для каждого сервиса по отдельности: суммарный процент
								     держат крупные и хорошо покрытые классы (TaskService,
								     AuthService), и на их фоне новый сервис с нулевым покрытием
								     сдвинет итог на доли процента, то есть пройдёт незамеченным.

								     Два исключения — единственные сервисы, до которых ни один
								     тест сегодня не доходит, и оба по понятной причине:
								     RateLimitService в профиле test выключен сознательно
								     (см. application-test.yml), UserService — это редактирование
								     профиля и загрузка аватарки, отдельный кусок, тестов на него
								     ещё нет. Список исключений и есть список долгов: появится
								     тест — строка отсюда уходит, а не наоборот. -->
								<rule>
									<element>CLASS</element>
									<excludes>
										<exclude>com.pmtracker.project_management_backend.ratelimit.RateLimitService</exclude>
										<exclude>com.pmtracker.project_management_backend.user.UserService</exclude>
									</excludes>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.50</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Тестам DB_PASSWORD из .env больше не нужен, и прокидывать его в surefire
			     тоже: интеграционные тесты идут в собственную Postgres из Testcontainers
			     (профиль test, см. src/test/resources/application-test.yml), а к локальной
			     базе из docker-compose не обращается никто. Раньше здесь стоял блок с
			     systemPropertyVariables, без которого ./mvnw test падал на
			     "password authentication failed for user pmtracker" — теперь для тестов
			     достаточно запущенного Docker. -->
		</plugins>
	</build>

</project>

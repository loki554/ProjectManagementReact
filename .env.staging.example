# Переменные стенда (docker-compose.staging.yml, 8.9 IMPROVEMENTS.md).
# Скопировать в .env.staging и заполнить. Набор тот же, что у прода (файл-накладка читает
# обе конфигурации), поэтому здесь только то, что на стенде отличается или добавляется.
# Полное описание каждой переменной — в .env.prod.example.

DB_NAME=pmtracker
DB_USERNAME=pmtracker
# Пароль стенда обязан отличаться от прод-пароля. Не из паранойи: стенд закрыт слабее,
# логи с него смотрят чаще и шире, а одинаковый пароль превращает утечку со стенда в
# утечку из прода.
DB_PASSWORD=

# SMTP на стенде НЕ используется: docker-compose.staging.yml перенаправляет почту в
# MailHog. Переменные всё равно должны быть заданы — прод-файл требует их без дефолтов,
# и без них compose не соберёт конфигурацию. Значения здесь ничего не значат.
MAIL_HOST=unused-on-staging
MAIL_PORT=1025
MAIL_USERNAME=unused
MAIL_PASSWORD=unused

# Свой секрет, не прод-овый: токен, выписанный стендом, не должен приниматься продом.
#   openssl rand -base64 48
JWT_SECRET=

# Публичный адрес стенда — отдельный домен или поддомен, не прод.
PUBLIC_BASE_URL=https://staging.tasks.example.com

TZ=Europe/Moscow

# Порт стенда на хосте (за тем же TLS-прокси, что и прод, но другим именем).
HTTP_PORT=8090
# Веб-интерфейс MailHog: там лежат все письма стенда.
MAILHOG_PORT=8025

# Бэкапы стенда: короткая ротация, данные всё равно тестовые.
BACKUP_RETENTION_DAYS=3
BACKUP_AT=03:30
BACKUP_VERIFY=true

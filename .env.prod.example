# Переменные прод-стека (docker-compose.prod.yml, 8.1 IMPROVEMENTS.md).
# Скопировать в .env.prod, заполнить, дальше:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# .env.prod в git не попадает (.gitignore закрывает .env.*, кроме примеров).
# Дефолтов у секретов здесь нет намеренно: приложение с незаданной переменной падает на
# старте с "Could not resolve placeholder", и это лучше, чем молча поднявшийся прод с
# чужим значением (см. application-prod.yml).

# --- база ---------------------------------------------------------------------------
DB_NAME=pmtracker
DB_USERNAME=pmtracker
# Длинный случайный пароль. Наружу порт 5432 не публикуется, но это не повод: с ним же
# ходят бэкапы (8.5), и восстанавливать базу придётся именно этим паролем.
DB_PASSWORD=

# --- почта --------------------------------------------------------------------------
# Реальный релей: письма — это подтверждение регистрации, сброс пароля и приглашения,
# то есть без работающего SMTP в аккаунт невозможно войти впервые.
# STARTTLS обязателен (mail.smtp.starttls.required в application-prod.yml): порт 587,
# а не 25. Порт 465 (implicit TLS) этой конфигурацией не поддерживается.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- приложение ---------------------------------------------------------------------
# Секрет подписи JWT: >= 32 байт случайных данных. Проверяется на старте (1.2), короткий
# или совпадающий с dev-дефолтом роняет контекст.
#   openssl rand -base64 48
# Ротация разлогинивает всех и гасит ссылки «отписаться» в уже разосланных письмах.
JWT_SECRET=

# Публичный адрес приложения — то, что человек видит в браузере. Идёт в ссылки писем
# и в CORS. Со схемой, без слеша на конце: https://tasks.example.com
PUBLIC_BASE_URL=

# Часовой пояс контейнера бэкенда: по нему считается расписание суточной сводки
# уведомлений (по умолчанию 9:00). В образе по умолчанию UTC.
TZ=Europe/Moscow

# Порт хоста, на который смотрит TLS-терминатор (Caddy/Traefik/балансировщик).
# В интернет этот порт выставлять не нужно — https делает прокси перед ним.
HTTP_PORT=8080
